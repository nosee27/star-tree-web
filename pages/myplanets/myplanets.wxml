<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="header-title">🪐 我的星球</text>
    <text class="back-btn" bindtap="goBack">← 返回</text>
  </view>
  
  <!-- 星球统计 -->
  <view class="stats-section">
    <view class="stat-card">
      <text class="stat-number">{{connectedPlanets.length}}</text>
      <text class="stat-label">已连接星球</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{totalInteractions}}</text>
      <text class="stat-label">总互动数</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{activePlanets.length}}</text>
      <text class="stat-label">活跃星球</text>
    </view>
  </view>
  
  <!-- 星球列表 -->
  <view class="planets-section">
    <text class="section-title">── 已连接的星球 ──</text>
    <view class="planets-list">
      <view class="planet-item" wx:for="{{connectedPlanets}}" wx:key="id">
        <view class="planet-header">
          <text class="planet-type">{{item.type}}</text>
          <text class="planet-status">{{item.status}}</text>
        </view>
        <text class="planet-name">{{item.name}}</text>
        <text class="planet-content">{{item.content}}</text>
        <view class="planet-stats">
          <text class="stat-item">互动: {{item.interactions}}次</text>
          <text class="stat-item">连接时间: {{item.connectTime}}</text>
        </view>
        <view class="planet-actions">
          <button class="btn btn-primary" bindtap="viewPlanetDetail" data-id="{{item.id}}">查看详情</button>
          <button class="btn btn-secondary" bindtap="disconnectPlanet" data-id="{{item.id}}">断开连接</button>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{connectedPlanets.length === 0}}">
    <text class="empty-icon">🪐</text>
    <text class="empty-text">还没有连接任何星球</text>
    <button class="btn btn-primary" bindtap="goToExplore">去探索星球</button>
  </view>
</view>