.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.back-btn {
  font-size: 32rpx;
  color: #666;
  padding: 10rpx;
}

.stats-section {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.stat-card {
  flex: 1;
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  margin: 0 5rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 5rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

.planets-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 20rpx;
}

.planets-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.planet-item {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.planet-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.planet-type {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.planet-status {
  font-size: 20rpx;
  color: #4CAF50;
  background-color: #E8F5E8;
  padding: 5rpx 15rpx;
  border-radius: 15rpx;
}

.planet-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.planet-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 15rpx;
}

.planet-stats {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #999;
  margin-bottom: 15rpx;
}

.planet-actions {
  display: flex;
  gap: 10rpx;
}

.btn {
  flex: 1;
  padding: 15rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
}

.btn-primary {
  background-color: #1E88E5;
  color: white;
  border: none;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
  border: 1rpx solid #ddd;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}