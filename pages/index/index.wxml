<view class="container">
  <!-- 顶部导航 -->
  <view class="top-nav">
    <text class="logo">🪐 树洞的星球</text>
    <view class="search-container">
      <input class="search-input" placeholder="搜索情绪、标签或用户" bindinput="bindSearchInput" value="{{searchKeyword}}"/>
      <text class="search-icon" bindtap="handleSearch">🔍</text>
    </view>
    <view class="top-actions">
      <text class="action-icon" bindtap="handlePublishClick">📝</text>
      <text class="action-icon" bindtap="handleUserClick">👤</text>
    </view>
  </view>
  
  <!-- 评论模态框 -->
  <view class="modal" wx:if="{{showCommentModal}}">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">发表评论</text>
        <text class="modal-close" bindtap="closeCommentModal">×</text>
      </view>
      <view class="modal-body">
        <textarea class="comment-input" placeholder="写下你的评论..." bindinput="bindCommentInput" value="{{commentContent}}" maxlength="500"></textarea>
        <text class="comment-count">{{commentContent.length}}/500</text>
      </view>
      <view class="modal-footer">
        <button class="btn btn-secondary" bindtap="closeCommentModal">取消</button>
        <button class="btn btn-primary" bindtap="submitComment">发布</button>
      </view>
    </view>
  </view>
  
  <!-- 主内容区 -->
  <view class="main-content">
    <!-- 发布框 -->
    <view class="publish-box">
      <textarea class="publish-input" placeholder="🪐 今天你的星球天气如何？分享你的情绪..." bindinput="bindPublishInput" value="{{publishContent}}"></textarea>
      
      <!-- 已选择的图片 -->
      <view class="selected-images" wx:if="{{selectedImages.length > 0}}">
        <view class="image-item" wx:for="{{selectedImages}}" wx:key="index">
          <image src="{{item}}" class="selected-image" bindtap="previewImage" data-index="{{index}}"></image>
          <text class="delete-image" bindtap="deleteImage" data-index="{{index}}">×</text>
        </view>
      </view>
      
      <view class="emotion-selector">
        <text class="emotion-item" bindtap="selectEmotion" data-emotion="😊">😊</text>
        <text class="emotion-item" bindtap="selectEmotion" data-emotion="😢">😢</text>
        <text class="emotion-item" bindtap="selectEmotion" data-emotion="😠">😠</text>
        <text class="emotion-item" bindtap="selectEmotion" data-emotion="😰">😰</text>
        <text class="emotion-item" bindtap="selectEmotion" data-emotion="😴">😴</text>
        <text class="emotion-item" bindtap="selectEmotion" data-emotion="🤗">🤗</text>
        <text class="emotion-item" bindtap="selectEmotion" data-emotion="🌧️">🌧️</text>
        <text class="emotion-item" bindtap="selectEmotion" data-emotion="⚡">⚡</text>
        <text class="emotion-item" bindtap="selectEmotion" data-emotion="🍃">🍃</text>
      </view>
      <view class="publish-actions">
        <text class="action-btn" bindtap="selectImage">[图片]</text>
        <button class="btn btn-primary" bindtap="publish">[发布]</button>
      </view>
    </view>
    
    <!-- 内容分类 -->
    <view class="content-tabs">
      <text class="tab-item active">推荐</text>
      <text class="tab-item">关注</text>
      <text class="tab-item">热门</text>
      <text class="tab-item">最新</text>
    </view>
    
    <!-- 内容列表 -->
    <view class="content-list">
      <!-- 内容项 1 -->
      <view class="content-item" wx:for="{{contentList}}" wx:key="id">
        <view class="item-header">
          <text class="item-author">{{item.author}}</text>
          <text class="item-time">{{item.time}}</text>
          <text class="item-visibility">{{item.visibility}}</text>
        </view>
        <view class="item-content">
          <text class="content-text">{{item.content}}</text>
          <!-- 图片显示 -->
          <view class="content-images" wx:if="{{item.images && item.images.length > 0}}">
            <image class="content-image" wx:for="{{item.images}}" wx:key="index" src="{{item}}" bindtap="previewContentImage" data-images="{{item.images}}" data-index="{{index}}"></image>
          </view>
          <text class="content-tags" wx:for="{{item.tags}}" wx:key="index">#{{item}}</text>
        </view>
        <view class="item-actions">
          <view class="action-item" bindtap="likePost" data-id="{{item.id}}">
            <text class="action-icon">💚</text>
            <text class="action-text">{{item.likes}}</text>
          </view>
          <view class="action-item" bindtap="commentPost" data-id="{{item.id}}">
            <text class="action-icon">💬</text>
            <text class="action-text">{{item.comments}}</text>
          </view>

          <view class="action-item" bindtap="resonancePost" data-id="{{item.id}}">
              <text class="action-icon">❤️</text>
              <text class="action-text">{{item.resonance || 0}}</text>
            </view>
        </view>
        
        <!-- 评论列表 -->
        <view class="comment-list" wx:if="{{item.commentList && item.commentList.length > 0}}">
          <text class="comment-title">评论 ({{item.comments}})</text>
          <view class="comment-item" wx:for="{{item.commentList}}" wx:key="id">
            <view class="comment-header">
              <text class="comment-author">{{item.author}}</text>
              <text class="comment-time">{{item.time}}</text>
            </view>
            <text class="comment-content">{{item.content}}</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 加载更多 -->
    <view class="load-more" bindtap="loadMore">
      <text class="load-more-text">[加载更多]</text>
    </view>
  </view>
</view>