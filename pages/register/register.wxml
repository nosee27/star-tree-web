<view class="container">
  <!-- 头部导航 -->
  <view class="header">
    <text class="header-title">🪐 树洞的星球</text>
    <text class="header-link" bindtap="navigateToLogin">已有账号？登录</text>
  </view>
  
  <!-- 进度指示器 -->
  <view class="progress-section">
    <text class="step-text">步骤 1 / 3    创建你的星球</text>
    <view class="progress-bar">
      <view class="progress-fill" style="width: 33%;"></view>
    </view>
  </view>
  
  <!-- 注册表单 -->
  <view class="form-section">
    <!-- 星球名称 -->
    <view class="form-group">
      <text class="form-label">🪐  星球名称 (可匿名，注册后可修改)</text>
      <view class="input-container">
        <input class="input" placeholder="流浪的星球" bindinput="bindPlanetNameInput"/>
        <text class="edit-icon">✏️</text>
      </view>
      <text class="form-hint">💡 建议使用匿名名称保护隐私</text>
    </view>
    
    <!-- 手机号 -->
    <view class="form-group">
      <text class="form-label">📧  手机号</text>
      <view class="phone-input">
        <view class="country-code">+86</view>
        <input class="input" placeholder="请输入手机号" bindinput="bindPhoneInput"/>
        <button class="btn btn-secondary" bindtap="getVerificationCode">{{countdown > 0 ? countdown + 's' : '📱 获取验证码'}}</button>
      </view>
    </view>
    
    <!-- 验证码 -->
    <view class="form-group">
      <text class="form-label">🔐  验证码</text>
      <input class="input" placeholder="请输入6位验证码" bindinput="bindVerificationCodeInput"/>
    </view>
    
    <!-- 下一步按钮 -->
    <button class="btn btn-primary" bindtap="nextStep">下一步 →</button>
    
    <!-- 用户协议 -->
    <view class="agreement-section">
      <text class="agreement-text">注册即表示同意 </text>
      <text class="agreement-link" bindtap="showUserAgreement">📄用户协议</text>
      <text class="agreement-text"> 和 </text>
      <text class="agreement-link" bindtap="showPrivacyPolicy">🔒隐私政策</text>
    </view>
  </view>
</view>