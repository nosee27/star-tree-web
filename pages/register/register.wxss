.container {
  padding: 20px;
  min-height: 100vh;
}

/* 头部导航 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 40px;
  margin-bottom: 30px;
}

.header-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.header-link {
  font-size: 14px;
  color: #4a90e2;
}

/* 进度指示器 */
.progress-section {
  margin-bottom: 40px;
}

.step-text {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 10px;
  display: block;
}

.progress-bar {
  width: 100%;
  height: 6px;
  background-color: #f0f0f0;
  border-radius: 3px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #4a90e2;
  border-radius: 3px;
  transition: width 0.3s;
}

/* 注册表单 */
.form-section {
  margin-bottom: 40px;
}

.form-group {
  margin-bottom: 25px;
}

.form-label {
  font-size: 14px;
  font-weight: 500;
  color: #333;
  margin-bottom: 10px;
  display: block;
}

.input-container {
  position: relative;
  margin-bottom: 10px;
}

.input {
  width: 100%;
  height: 48px;
  padding: 0 16px;
  border: 1px solid #e0e0e0;
  border-radius: 24px;
  font-size: 14px;
  position: relative;
  z-index: 10;
}

.edit-icon {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 16px;
  color: #999;
}

.form-hint {
  font-size: 12px;
  color: #999;
  margin-top: 5px;
  display: block;
}

/* 手机号输入 */
.phone-input {
  display: flex;
  align-items: center;
  gap: 10px;
}

.country-code {
  font-size: 14px;
  color: #333;
  padding: 0 10px;
  white-space: nowrap;
}

.phone-input .input {
  flex: 2;
  min-width: 0;
  position: relative;
  z-index: 10;
}

.phone-input .btn {
  flex: 1;
  white-space: nowrap;
  max-width: 150px;
  margin-bottom: 0;
}

/* 按钮 */
.btn {
  width: 100%;
  height: 48px;
  border-radius: 24px;
  font-size: 16px;
  margin-bottom: 20px;
}

.btn-primary {
  background-color: #4a90e2;
  color: white;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
  font-size: 14px;
  padding: 0 16px;
  height: 36px;
  line-height: 36px;
}

/* 用户协议 */
.agreement-section {
  text-align: center;
  margin-top: 20px;
}

.agreement-text {
  font-size: 12px;
  color: #999;
}

.agreement-link {
  font-size: 12px;
  color: #4a90e2;
}