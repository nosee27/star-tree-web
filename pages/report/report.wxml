<view class="report-container">
  <view class="report-header">
    <text class="report-title">我的情绪报告</text>
  </view>
  
  <!-- 情绪概览 -->
  <view class="emotion-overview">
    <view class="emotion-card">
      <view class="emotion-icon">😊</view>
      <view class="emotion-info">
        <view class="emotion-label">今日情绪</view>
        <view class="emotion-value">积极</view>
      </view>
    </view>
    
    <view class="emotion-card">
      <view class="emotion-icon">📊</view>
      <view class="emotion-info">
        <view class="emotion-label">本周趋势</view>
        <view class="emotion-value">上升</view>
      </view>
    </view>
  </view>
  
  <!-- 情绪分析 -->
  <view class="report-section">
    <view class="section-title">情绪分析</view>
    <view class="analysis-content">
      <view class="analysis-item">
        <view class="analysis-label">积极情绪</view>
        <view class="analysis-bar">
          <view class="analysis-fill" style="width: 75%;"></view>
        </view>
        <view class="analysis-value">75%</view>
      </view>
      
      <view class="analysis-item">
        <view class="analysis-label">中性情绪</view>
        <view class="analysis-bar">
          <view class="analysis-fill neutral" style="width: 20%;"></view>
        </view>
        <view class="analysis-value">20%</view>
      </view>
      
      <view class="analysis-item">
        <view class="analysis-label">消极情绪</view>
        <view class="analysis-bar">
          <view class="analysis-fill negative" style="width: 5%;"></view>
        </view>
        <view class="analysis-value">5%</view>
      </view>
    </view>
  </view>
  
  <!-- 情绪趋势 -->
  <view class="report-section">
    <view class="section-title">情绪趋势</view>
    <view class="trend-chart">
      <view class="trend-item">
        <view class="trend-date">周一</view>
        <view class="trend-bar" style="height: 60%;"></view>
      </view>
      <view class="trend-item">
        <view class="trend-date">周二</view>
        <view class="trend-bar" style="height: 50%;"></view>
      </view>
      <view class="trend-item">
        <view class="trend-date">周三</view>
        <view class="trend-bar" style="height: 70%;"></view>
      </view>
      <view class="trend-item">
        <view class="trend-date">周四</view>
        <view class="trend-bar" style="height: 65%;"></view>
      </view>
      <view class="trend-item">
        <view class="trend-date">周五</view>
        <view class="trend-bar" style="height: 80%;"></view>
      </view>
      <view class="trend-item">
        <view class="trend-date">周六</view>
        <view class="trend-bar" style="height: 85%;"></view>
      </view>
      <view class="trend-item">
        <view class="trend-date">周日</view>
        <view class="trend-bar" style="height: 75%;"></view>
      </view>
    </view>
  </view>
  
  <!-- 情绪建议 -->
  <view class="report-section">
    <view class="section-title">情绪建议</view>
    <view class="suggestion-content">
      <view class="suggestion-item">
        <view class="suggestion-icon">💡</view>
        <view class="suggestion-text">保持当前积极的心态，继续分享你的快乐</view>
      </view>
      <view class="suggestion-item">
        <view class="suggestion-icon">🎯</view>
        <view class="suggestion-text">尝试每天记录一件让你开心的事情</view>
      </view>
      <view class="suggestion-item">
        <view class="suggestion-icon">🤝</view>
        <view class="suggestion-text">多与朋友互动，分享彼此的情绪</view>
      </view>
    </view>
  </view>
</view>