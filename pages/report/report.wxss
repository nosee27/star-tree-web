.report-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 报告头部 */
.report-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.report-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 情绪概览 */
.emotion-overview {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.emotion-card {
  flex: 1;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
}

.emotion-card:last-child {
  margin-right: 0;
}

.emotion-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.emotion-info {
  flex: 1;
}

.emotion-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.emotion-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

/* 报告 section */
.report-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 情绪分析 */
.analysis-content {
  display: flex;
  flex-direction: column;
}

.analysis-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.analysis-item:last-child {
  margin-bottom: 0;
}

.analysis-label {
  width: 120rpx;
  font-size: 24rpx;
  color: #666;
}

.analysis-bar {
  flex: 1;
  height: 16rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.analysis-fill {
  height: 100%;
  border-radius: 8rpx;
  background-color: #4CAF50;
}

.analysis-fill.neutral {
  background-color: #ff9800;
}

.analysis-fill.negative {
  background-color: #f44336;
}

.analysis-value {
  width: 60rpx;
  font-size: 24rpx;
  color: #666;
  text-align: right;
}

/* 情绪趋势 */
.trend-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding-top: 20rpx;
}

.trend-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.trend-date {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.trend-bar {
  width: 32rpx;
  background-color: #4CAF50;
  border-radius: 16rpx 16rpx 0 0;
}

/* 情绪建议 */
.suggestion-content {
  display: flex;
  flex-direction: column;
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
}

.suggestion-item:last-child {
  margin-bottom: 0;
}

.suggestion-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.suggestion-text {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .report-container {
    padding: 16rpx;
  }
  
  .report-title {
    font-size: 32rpx;
  }
  
  .emotion-card {
    padding: 20rpx;
  }
  
  .emotion-icon {
    font-size: 40rpx;
  }
  
  .emotion-label {
    font-size: 20rpx;
  }
  
  .emotion-value {
    font-size: 24rpx;
  }
  
  .report-section {
    padding: 20rpx;
  }
  
  .section-title {
    font-size: 24rpx;
  }
  
  .analysis-label {
    font-size: 20rpx;
    width: 100rpx;
  }
  
  .analysis-value {
    font-size: 20rpx;
  }
  
  .trend-chart {
    height: 160rpx;
  }
  
  .trend-bar {
    width: 24rpx;
  }
  
  .suggestion-text {
    font-size: 20rpx;
  }
}