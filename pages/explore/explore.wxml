<view class="container">
  <!-- 评论模态框 -->
  <view class="modal" wx:if="{{showCommentModal}}">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">发表评论</text>
        <text class="modal-close" bindtap="closeCommentModal">×</text>
      </view>
      <view class="modal-body">
        <textarea class="comment-input" placeholder="写下你的评论..." bindinput="bindCommentInput" value="{{commentContent}}" maxlength="500"></textarea>
        <text class="comment-count">{{commentContent.length}}/500</text>
      </view>
      <view class="modal-footer">
        <button class="btn btn-secondary" bindtap="closeCommentModal">取消</button>
        <button class="btn btn-primary" bindtap="submitComment">发布</button>
      </view>
    </view>
  </view>
  
  <!-- 头部 -->
  <view class="header">
    <text class="header-title">🪐 探索星球</text>
  </view>
  
  <!-- 星球动画区域 -->
  <view class="planet-animation" bindtap="explorePlanet">
    <view class="stars">
      <text class="star">✨</text>
      <text class="star">🪐</text>
      <text class="star">✨</text>
      <text class="star">✨</text>
      <text class="star">🪐</text>
      <text class="star">✨</text>
      <text class="star">✨</text>
      <text class="star">🪐</text>
      <text class="star">✨</text>
    </view>
    <text class="explore-btn">🚀 探索一颗新星球</text>
    <text class="explore-remain">今日剩余：{{exploreCount}}/{{maxExploreCount}}</text>
  </view>
  
  <!-- 功能卡片 -->
  <view class="feature-cards">
    <view class="feature-card" bindtap="sendSignal">
      <text class="feature-icon">📝</text>
      <text class="feature-title">发信号</text>
      <text class="feature-desc">剩余 {{signalCount}}/{{maxSignalCount}}</text>
    </view>
    <view class="feature-card" bindtap="myPlanets">
      <text class="feature-icon">📬</text>
      <text class="feature-title">我的星球</text>
      <text class="feature-desc">星球</text>
    </view>
    <view class="feature-card" bindtap="achievements">
      <text class="feature-icon">🏆</text>
      <text class="feature-title">成就</text>
      <text class="feature-desc">徽章</text>
    </view>
  </view>
  
  <!-- 星球类型筛选 -->
  <view class="filter-section">
    <text class="filter-title">── 星球类型筛选 ──</text>
    <view class="filter-tags">
      <text class="filter-tag active" bindtap="handleFilterTag" data-tag="全部">全部</text>
      <text class="filter-tag" bindtap="handleFilterTag" data-tag="倾诉">📝倾诉</text>
      <text class="filter-tag" bindtap="handleFilterTag" data-tag="共鸣">💚共鸣</text>
      <text class="filter-tag" bindtap="handleFilterTag" data-tag="祝福">🌟祝福</text>
      <text class="filter-tag" bindtap="handleFilterTag" data-tag="问答">❓问答</text>
      <text class="filter-tag" bindtap="handleFilterTag" data-tag="树洞">🌳树洞</text>
    </view>
  </view>
  
  <!-- 最近探索 -->
  <view class="recent-section">
    <text class="section-title">── 最近探索 ──</text>
    <view class="recent-list">
      <view class="recent-item" wx:for="{{recentExplores}}" wx:key="id">
        <view class="item-header">
          <text class="item-author">{{item.author}}</text>
          <text class="item-time">探索于 {{item.time}}</text>
          <text class="item-status">{{item.status}}</text>
          <text class="item-type">{{item.type}}</text>
        </view>
        <text class="item-content">{{item.content}}</text>
        <text class="item-info">{{item.info}}</text>
        <view class="item-actions">
          <view class="action-item" bindtap="likePlanet" data-id="{{item.id}}">
            <text class="action-icon">💚</text>
            <text class="action-text">{{item.likes}}</text>
          </view>
          <view class="action-item" bindtap="commentPlanet" data-id="{{item.id}}">
            <text class="action-icon">💬</text>
            <text class="action-text">{{item.comments}}</text>
          </view>

        </view>
        
        <!-- 评论列表 -->
        <view class="comment-list" wx:if="{{item.commentList && item.commentList.length > 0}}">
          <text class="comment-title">评论 ({{item.comments}})</text>
          <view class="comment-item" wx:for="{{item.commentList}}" wx:key="id">
            <view class="comment-header">
              <text class="comment-author">{{item.author}}</text>
              <text class="comment-time">{{item.time}}</text>
            </view>
            <text class="comment-content">{{item.content}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>