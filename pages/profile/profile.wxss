.profile-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 个人信息区域 */
.profile-header {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar {
  font-size: 80rpx;
  margin-right: 24rpx;
}

.user-details {
  flex: 1;
}

.username {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.join-date {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.badge {
  font-size: 24rpx;
  color: #ff9500;
}

/* 统计数据 */
.stats-container {
  display: flex;
  justify-content: space-around;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 功能菜单 */
.menu-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.menu-title {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 24rpx;
  width: 40rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 24rpx;
  color: #999;
}

.menu-toggle {
  font-size: 24rpx;
  color: #4CAF50;
}

/* 退出登录按钮 */
.logout {
  margin-top: 16rpx;
}

.logout .menu-text {
  color: #ff4757;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .profile-container {
    padding: 16rpx;
  }
  
  .profile-header {
    padding: 24rpx;
  }
  
  .avatar {
    font-size: 64rpx;
  }
  
  .username {
    font-size: 28rpx;
  }
  
  .join-date,
  .badge {
    font-size: 20rpx;
  }
  
  .stat-number {
    font-size: 28rpx;
  }
  
  .stat-label {
    font-size: 20rpx;
  }
  
  .menu-section {
    padding: 20rpx;
  }
  
  .menu-item {
    padding: 20rpx 0;
  }
  
  .menu-text {
    font-size: 24rpx;
  }
}