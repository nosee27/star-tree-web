.container {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  width: 100%;
  text-align: center;
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
}

.treehole-section {
  width: 100%;
  max-width: 600rpx;
  background-color: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 40rpx;
}

.tree-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
  height: 400rpx;
}

.tree-trunk {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.trunk-body {
  width: 40rpx;
  height: 200rpx;
  background-color: #8B4513;
  border-radius: 20rpx 20rpx 0 0;
}

.trunk-base {
  width: 60rpx;
  height: 20rpx;
  background-color: #654321;
  border-radius: 10rpx;
}

.tree-hole {
  position: absolute;
  top: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 40rpx;
  z-index: 2;
}

.tree-canopy {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 200rpx;
  z-index: 0;
}

.branch {
  position: absolute;
  width: 80rpx;
  height: 10rpx;
  background-color: #6B8E23;
  border-radius: 5rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.branch-left-1 {
  top: 40rpx;
  left: 20rpx;
  transform: rotate(-30deg);
}

.branch-right-1 {
  top: 40rpx;
  right: 20rpx;
  transform: rotate(30deg);
}

.branch-left-2 {
  top: 80rpx;
  left: 40rpx;
  transform: rotate(-45deg);
}

.branch-right-2 {
  top: 80rpx;
  right: 40rpx;
  transform: rotate(45deg);
}

.leaves {
  font-size: 20rpx;
  animation: leafGrow 0.5s ease-out forwards;
  opacity: 0;
  transform: scale(0);
}

@keyframes leafGrow {
  0% {
    opacity: 0;
    transform: scale(0);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

.tree-text {
  font-size: 24rpx;
  color: #2c3e50;
  margin-top: 20rpx;
  text-align: center;
}

.tree-subtext {
  font-size: 20rpx;
  color: #7f8c8d;
  margin-top: 10rpx;
  text-align: center;
}

.leaves-count {
  font-size: 18rpx;
  color: #27ae60;
  margin-top: 20rpx;
  text-align: center;
  font-weight: bold;
}

.history-btn {
  font-size: 16rpx;
  color: #4a90e2;
  margin-top: 15rpx;
  text-align: center;
  cursor: pointer;
  padding: 5rpx 10rpx;
  border-radius: 15rpx;
  background-color: #f0f7ff;
  display: inline-block;
  align-self: center;
  margin-top: 10rpx;
}

.history-btn:hover {
  background-color: #e0f0ff;
}

/* 历史消息部分 */
.history-section {
  margin-top: 30rpx;
  padding: 20rpx;
  background-color: white;
  border-radius: 15rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.history-title {
  font-size: 20rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.history-item {
  padding: 15rpx;
  background-color: #f9f9f9;
  border-radius: 10rpx;
  border-left: 4rpx solid #4a90e2;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.history-time {
  font-size: 14rpx;
  color: #999;
}

.delete-btn {
  font-size: 14rpx;
  color: #e74c3c;
  cursor: pointer;
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  background-color: #fef2f2;
}

.delete-btn:hover {
  background-color: #fee2e2;
}

.history-content {
  font-size: 16rpx;
  color: #333;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
}

.empty-history {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 16rpx;
  background-color: #f9f9f9;
  border-radius: 10rpx;
}

.publish-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.textarea {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 20rpx;
  resize: none;
}

.word-count {
  align-self: flex-end;
  font-size: 16rpx;
  color: #999;
}

.btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.btn-primary {
  background-color: #4CAF50;
  color: white;
  border: none;
}

.btn-primary:hover {
  background-color: #45a049;
}

.rules-section {
  width: 100%;
  max-width: 600rpx;
  background-color: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.rules-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #2c3e50;
  text-align: center;
  margin-bottom: 30rpx;
}

.rules-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rule-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.rule-icon {
  font-size: 24rpx;
}

.rule-text {
  font-size: 20rpx;
  color: #555;
  flex: 1;
}