<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="header-title">🌳 树洞</text>
  </view>
  
  <!-- 树洞区域 -->
  <view class="treehole-section">
    <view class="tree-container">
      <!-- 树干 -->
      <view class="tree-trunk">
        <view class="trunk-body"></view>
        <view class="trunk-base"></view>
      </view>
      
      <!-- 树洞 -->
      <view class="tree-hole">🕳️</view>
      
      <!-- 树枝和叶子 -->
      <view class="tree-canopy">
        <view class="branch branch-left-1">
          <view class="leaves" wx:for="{{leaves}}" wx:key="{{index}}" style="animation-delay: {{index * 0.1}}s;">
            �
          </view>
        </view>
        <view class="branch branch-right-1">
          <view class="leaves" wx:for="{{leaves}}" wx:key="{{index}}" style="animation-delay: {{index * 0.1}}s;">
            🍃
          </view>
        </view>
        <view class="branch branch-left-2">
          <view class="leaves" wx:for="{{leaves}}" wx:key="{{index}}" style="animation-delay: {{index * 0.1}}s;">
            🍃
          </view>
        </view>
        <view class="branch branch-right-2">
          <view class="leaves" wx:for="{{leaves}}" wx:key="{{index}}" style="animation-delay: {{index * 0.1}}s;">
            🍃
          </view>
        </view>
      </view>
      
      <text class="tree-text">对着树洞说出你的心事</text>
      <text class="tree-subtext">树洞会保守所有秘密</text>
      <text class="leaves-count">已收集 {{leaves.length}}/999 片叶子</text>
      <text class="history-btn" bindtap="toggleHistory">📋 {{showHistory ? '隐藏' : '查看'}}历史消息</text>
    </view>
    
    <view class="publish-form">
      <textarea class="textarea" placeholder="写下你的心事..." bindinput="bindTextAreaInput" value="{{content}}" maxlength="1000"></textarea>
      <text class="word-count">{{content.length}}/1000</text>
      <button class="btn btn-primary" bindtap="publish">投入树洞 🌳</button>
    </view>
    
    <!-- 历史消息列表 -->
    <view class="history-section" wx:if="{{showHistory}}">
      <text class="history-title">── 树洞消息记录 ──</text>
      <view class="history-list" wx:if="{{messages.length > 0}}">
        <view class="history-item" wx:for="{{messages}}" wx:key="id">
          <view class="history-header">
            <text class="history-time">{{item.time}}</text>
            <text class="delete-btn" bindtap="deleteMessage" data-id="{{item.id}}">删除</text>
          </view>
          <text class="history-content">{{item.content}}</text>
        </view>
      </view>
      <view class="empty-history" wx:else>
        <text class="empty-text">还没有消息记录</text>
      </view>
    </view>
  </view>
  
  <!-- 树洞规则 -->
  <view class="rules-section">
    <text class="rules-title">── 树洞规则 ──</text>
    <view class="rules-list">
      <view class="rule-item">
        <text class="rule-icon">✅</text>
        <text class="rule-text">匿名发布，无人知道你的身份</text>
      </view>
      <view class="rule-item">
        <text class="rule-icon">✅</text>
        <text class="rule-text">内容经过安全审核，保护你我</text>
      </view>
      <view class="rule-item">
        <text class="rule-icon">✅</text>
        <text class="rule-text">可选择是否允许他人回应</text>
      </view>
      <view class="rule-item">
        <text class="rule-icon">✅</text>
        <text class="rule-text">72小时后自动封存，或手动删除</text>
      </view>
    </view>
  </view>
</view>