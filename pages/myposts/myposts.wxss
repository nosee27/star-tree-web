.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

/* 头部导航 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 40rpx;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.header-back {
  font-size: 36rpx;
  color: #666;
  cursor: pointer;
}

/* 发布统计 */
.stats-section {
  background-color: white;
  border-radius: 15rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #4a90e2;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #666;
}

/* 发布列表 */
.posts-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
  display: block;
}

.posts-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.post-item {
  background-color: white;
  border-radius: 15rpx;
  padding: 25rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.post-time {
  font-size: 16rpx;
  color: #999;
}

.post-visibility {
  font-size: 16rpx;
  color: #666;
  padding: 2rpx 10rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
}

.post-content {
  font-size: 20rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 15rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 图片显示 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 15rpx;
}

.post-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  object-fit: cover;
}

/* 标签 */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 15rpx;
}

.post-tag {
  font-size: 14rpx;
  color: #4a90e2;
  background-color: #f0f7ff;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* 互动数据 */
.post-stats {
  display: flex;
  gap: 30rpx;
  margin-bottom: 15rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  font-size: 16rpx;
  color: #666;
  display: flex;
  align-items: center;
  gap: 5rpx;
}

/* 操作按钮 */
.post-actions {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  font-size: 16rpx;
  color: #4a90e2;
  padding: 6rpx 16rpx;
  border: 1rpx solid #4a90e2;
  border-radius: 15rpx;
  cursor: pointer;
}

.action-btn.delete {
  color: #e74c3c;
  border-color: #e74c3c;
}

/* 空状态 */
.empty-state {
  background-color: white;
  border-radius: 15rpx;
  padding: 60rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.empty-hint {
  font-size: 18rpx;
  color: #999;
  margin-bottom: 30rpx;
  display: block;
}

/* 按钮样式 */
.btn {
  padding: 15rpx 30rpx;
  border-radius: 25rpx;
  font-size: 20rpx;
  font-weight: 500;
  cursor: pointer;
  border: none;
}

.btn-primary {
  background-color: #4a90e2;
  color: white;
}

.btn-primary:hover {
  background-color: #3a80d2;
}